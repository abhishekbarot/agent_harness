# Credentials are resolved by the SDK in this order:
#   ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> an `ant auth login` profile.
# If you have run `ant auth login`, you do not need to set anything here.
ANTHROPIC_API_KEY=

# Harness configuration (all optional; these are the defaults).
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high
AGENT_MAX_TOKENS=16000
AGENT_MAX_TURNS=25
AGENT_PERMISSION_MODE=ask
AGENT_CONTEXT_STRATEGY=clear_tool_uses
AGENT_LOG_FORMAT=text
AGENT_LOG_LEVEL=INFO
